+                            band_view.data = (char *) tensor->data
+                                + ggml_row_size(tensor->type, n_per_row) * row_off;
+                            llama_tensor_dequantize_impl(&band_view, f32_conv_buf, workers, band_elems, nthread);
+                            f32_band = (const float *) f32_conv_buf.data();
+                        }
+
+                        void * new_data_band = (char *) new_data
+                            + ggml_row_size(new_type, n_per_row) * row_off;
+
+                        new_size += llama_tensor_quantize_impl(new_type, f32_band, new_data_band,
+                                chunk_size, band_rows, n_per_row, imatrix_03, workers, nthread_use);
+                    }
